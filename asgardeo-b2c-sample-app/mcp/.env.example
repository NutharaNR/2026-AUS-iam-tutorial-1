# Port used by the MCP server.
MCP_PORT=8000

# Host used by the MCP server.
HOST=localhost

# Path to the Wayfinder API's database module. The MCP server reads and writes
# the travel database in process rather than calling the REST API, so it loads
# this module directly. Defaults to ../api/src/db.ts; set it only if the API
# lives elsewhere.
# API_DB_MODULE=

# Enforce token verification and per-tool scope checks at the MCP boundary.
# When false (default), tools run without authorization -- local demos only.
MCP_REQUIRE_AUTH=false

## Asgardeo configuration details required for access token validation.
# Required only when API_REQUIMCP_REQUIRE_AUTHRE_AUTH=true.
ASGARDEO_BASE_URL=
ASGARDEO_AUDIENCE=<your-wayfinder-api-resource-identifier>
